# Model provider environment
# Copy this file to .env. Set values only for the profile selected by `active`
# in configs/parser_config/model_backend.yaml. Keep credentials in .env and
# never commit them. Profile names, model IDs, and generation settings belong
# in model_backend.yaml; this file contains the environment values they read.

# Profile-to-environment-variable reference:
#   openai, anthropic, gemini       -> corresponding provider API key
#   openai_compatible               -> model, base URL, and optional API key
#   ollama and ollama_* profiles    -> OLLAMA_HOST
#   transformers_local              -> optional HF_TOKEN for gated/private models
#   semantic_document_student       -> no provider environment variable

# Hosted providers: set the key for the selected profile.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# OpenAI-compatible endpoint (for example, vLLM, Together, or Groq).
# Set the model ID and base URL for your endpoint. The API key may be blank
# when the endpoint does not require authentication.
OPENAI_COMPATIBLE_MODEL_USED=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=

# Ollama server used by all Ollama profiles.
# Defaults to the local Ollama service at http://localhost:11434.
OLLAMA_HOST=http://localhost:11434

# Hugging Face token, needed only for private or gated model downloads.
HF_TOKEN=
