# Copy this file to .env, then add only the credentials you use.

# Hosted model providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional: OpenAI-compatible service (vLLM, Together, Groq, etc.).
# Leave OPENAI_COMPATIBLE_API_KEY empty if the endpoint does not require one.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=

# Optional: remote/local Ollama server to run LLMs locally.
# The default is http://localhost:11434.
OLLAMA_HOST=http://localhost:11434

# Optional: Hugging Face token for private or gated local models.
HF_TOKEN=
